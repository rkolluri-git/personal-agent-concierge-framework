# Copy this file to .env before starting Family Agent.
# Use a long, unique value. Never commit the real .env file.
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Optional Google Places (New) address suggestions.
GOOGLE_PLACES_API_KEY=

# Optional structured Concierge interpretation. Leave provider as none for local rules only.
FAMILY_LLM_PROVIDER=none
FAMILY_LLM_MODEL=qwen3.5:9b

# Regional formatting (the interface and Concierge currently use English).
FAMILY_LOCALE=en-US
FAMILY_COUNTRY=US
FAMILY_TIMEZONE=America/New_York
FAMILY_UNITS=imperial
# none, custom (config/school-calendar.json), or cobb (Georgia, USA only)
FAMILY_SCHOOL_CALENDAR=none

# India example: en-IN, IN, Asia/Kolkata, metric
# UK example: en-GB, GB, Europe/London, metric
# Germany example: de-DE, DE, Europe/Berlin, metric

# Optional Windows/Linux messaging: imessage, twilio-sms, twilio-whatsapp, openclaw
FAMILY_MESSAGING_PROVIDER=imessage
# Twilio: set COMPOSE_PROFILES=messaging; OpenClaw: messaging-ingress
# Credentials and dedicated sender live only in config/messaging.json.

# Local Ollama alternative: FAMILY_LLM_PROVIDER=ollama, FAMILY_LLM_MODEL=qwen3.5:9b
OLLAMA_BASE_URL=http://host.docker.internal:11434
